<?xml version='1.0'?><!-- Game is either sse, tesv, or fo4 -->
<PapyrusProject xmlns="PapyrusProject.xsd" 
    Flags="TESV_Papyrus_Flags.flg" 
    Game="sse" 
    Output="Scripts" 
    Optimize="true" 
    Anonymize="true" 
    Package="false" 
    Zip="true">
    <Variables>
        <Variable Name="ModName" Value="SkyrimCinematicSystem"/>
        <Variable Name="ThisProject" Value="."/>
        <Variable Name="Rel" Value=".\.release"/>
        <Variable Name="MO2" Value="D:\Games\Skyrim\MO2\mods\"/>
        <Variable Name="Ver" Value="0.4.0"/>
    </Variables>
    <Imports>
        <Import>@ThisProject\Data\Source\Scripts</Import>
        <!-- <Import>@MO2\Devious Devices NG\Source\Scripts</Import> -->
        <!-- <Import>@MO2\Devious Devices\Source\scripts</Import> -->
        <!-- <Import>@MO2\SexLabArousedSSELoose\source\scripts</Import> -->
        <!-- <Import>@MO2\Sexlab Framework PPLUS\Source\Scripts</Import> -->
        <!-- <Import>@MO2\SexLab Framework AE\Source\scripts</Import> -->
		<!-- <Import>@MO2\SkyrimLovense\Source\Scripts</Import> -->
        <Import>@MO2\PapyrusUtil SE - Modders Scripting Utility Functions\Source\Scripts</Import>
        <Import>@MO2\SkyUI SDK\Source\Scripts</Import>
        <!-- <Import>@MO2\XP32 Maximum Skeleton Special Extended - XPMSSE\source\scripts</Import> -->
        <!-- <Import>@MO2\RaceMenu SDK\source\scripts</Import> -->
        <!-- <Import>@MO2\ConsoleUtilSSE SDK\Source\Scripts</Import> -->
        <!-- <Import>@MO2\JContainers SE\source\scripts</Import> -->
        <!-- <Import>@MO2\UIExtensions\scripts\source</Import> -->
        <!-- <Import>@MO2\Mfg Fix NG\Source\Scripts</Import> -->
        <!-- <Import>@MO2\Mfg Fix\source\scripts</Import> -->
        <!-- <Import>@MO2\AnimSpeedSE\source\scripts</Import> -->
        <!-- <Import>@MO2\FNIS SDK\source\scripts</Import> -->
        <Import>@MO2\Skyrim Script Extender (SKSE64)\Source\Scripts</Import>
        <Import>@MO2\BaseGame Scripts\Source\Scripts</Import>
    </Imports>
    <Folders>
        <Folder>@ThisProject\Source\Scripts</Folder>
    </Folders>
    <ZipFiles Output="@Rel">
        <ZipFile Name="@ModName-@Ver" RootDir="@ThisProject" Compression="deflate">
            <Include>@ModName.esp</Include>
            <!-- <Include>Interface</Include> -->
            <!-- <Include>docs</Include> -->
            <Include>Scripts</Include>
            <!-- <Include>Sound</Include> -->
            <Include>Source</Include>
            <Include>SKSE</Include>
            <!-- <Include>SEQ</Include> -->
        </ZipFile>
    </ZipFiles>
</PapyrusProject>